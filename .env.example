# Copia este archivo como .env y completa los datos que faltan.
#   cp .env.example .env

# Base de datos de la aplicación (la del contenedor "db" de docker compose).
# El contenedor publica PostgreSQL en el puerto 5433 de tu computador.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=clase
DB_USER=alumno
# Es la contraseña con la que docker compose crea la base: no la cambies
# después de haberla creado (o borra el volumen con docker compose down -v).
DB_PASSWORD=mi_clave_segura

# Autenticación (JWT). Obligatorio para levantar la API.
# Genera un secreto propio con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=7
# false solo en desarrollo (http). En producción, con HTTPS, debe ser true.
COOKIE_SECURE=false

# Administrador que aprueba las cuentas nuevas. Sin ADMIN_PASSWORD no se crea.
# Al arrancar, la API deja a este usuario con exactamente estos datos.
ADMIN_EMAIL=admin@academico.test
ADMIN_PASSWORD=

# pgAdmin (http://localhost:5050). Solo se usan la primera vez que arranca.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=

# Puertos publicados en tu computador (opcionales: estos son los valores por defecto).
# DB_PORT_HOST=5433
# APP_PORT=8080
# PGADMIN_PORT=5050

# Base de pruebas (la usa pytest; la crea db-init con docker compose up -d db).
# Es otra base: los tests la vacían después de cada test. En local la
# contraseña debe ser la misma que DB_PASSWORD; en CI sale de un secret.
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=clase_test
TEST_DB_USER=alumno
TEST_DB_PASSWORD=mi_clave_segura
